# ============================================
# InterviewMentorAI — Python AI 后端环境变量
# 复制此文件为 .env 并填入实际值
# ============================================

# DashScope API Key（阿里云百炼）
# 注意：此 Key 用于语音识别/LLM（qwen3.5-omni-plus），RAG 使用独立的 RAG_API_KEY
# 获取地址：https://dashscope.aliyuncs.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# LLM 模型配置
# 注意：ASR 语音识别必须使用多模态模型 qwen3.5-omni-plus
# 纯文本模型 qwen-plus 无法处理音频文件
LLM_MODEL_NAME=qwen3.5-omni-plus
LLM_TEMPERATURE=0.3
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Java 业务后端地址
JAVA_BACKEND_URL=http://localhost:8080

# 音频文件存储路径
AUDIO_STORAGE_PATH=./data/audio

# RAG 知识库配置（本地离线模型）
# 注意：所有相对路径（./xxx）均锚定到项目根 backend_python 目录解析，
# 与启动目录无关，换机器/从任意目录启动都指向项目内同一位置
RAG_DOC_ROOT=./data/rag_docs
SQLITE_DB_PATH=./data/interview.db
# 本地嵌入模型（首次从 HuggingFace 下载，之后完全离线；输出 1024 维）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 本地模型缓存目录（HuggingFace hub 格式，随项目可移植）
MODEL_CACHE_DIR=./models/hf_cache
# 以下 Key 配置已离线化废弃（保留仅作兼容），本地模型不再调用外部 API
RAG_API_KEY=
# 本地重排序模型（CrossEncoder，离线）
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_BASE_URL=
RAG_TOP_K=3
RAG_THRESHOLD=0.6
# 切块参数：答案按句/段边界切分，块越小检索聚焦度越高（面试场景 300 字较优）
CHUNK_SIZE=300
CHUNK_OVERLAP=60
# PDF 图片 OCR（离线，RapidOCR）：开启后提取图片区域文字并入题目答案
PDF_OCR_ENABLED=true
PDF_OCR_RESOLUTION=300
