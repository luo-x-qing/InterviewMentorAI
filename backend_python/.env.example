# ============================================
# InterviewMentorAI — Python AI 后端环境变量
# 复制此文件为 .env 并填入实际值
# ============================================

# DashScope API Key（阿里云百炼）
# 获取地址：https://dashscope.aliyuncs.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# LLM 模型配置
# 注意：ASR 语音识别必须使用多模态模型 qwen3.5-omni-plus
# 纯文本模型 qwen-plus 无法处理音频文件
LLM_MODEL_NAME=qwen3.5-omni-plus
LLM_TEMPERATURE=0.3
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Java 业务后端地址
JAVA_BACKEND_URL=http://localhost:8080

# 音频文件存储路径
AUDIO_STORAGE_PATH=./data/audio

# RAG 知识库配置
RAG_DOC_ROOT=./data/rag_docs
SQLITE_DB_PATH=./data/interview.db
EMBEDDING_MODEL=text-embedding-v3
RAG_TOP_K=3
RAG_THRESHOLD=0.6
CHUNK_SIZE=500
CHUNK_OVERLAP=100
