# ============================================
# InterviewMentorAI — Java 业务后端环境变量
# 配置方式：
#   IDE：设置 Run Configuration 的 Environment Variables
#   Docker：在 docker-compose.yml 中配置
#   CLI：export XXX=yyy && mvn spring-boot:run
# ============================================

# MySQL 数据库密码（必填）
MYSQL_PASSWORD=your_mysql_password

# JWT 签名密钥（生产环境务必更换为随机字符串）
# 生成命令：openssl rand -base64 64
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-64

# Python AI 后端地址
PYTHON_AI_BACKEND_URL=http://localhost:8000

# 音频文件存储路径
AUDIO_STORAGE_PATH=./data/audio
